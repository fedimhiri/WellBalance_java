<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.wellbalance.controllers.ModifierTypeRendezVousController"
            styleClass="app-shell">

    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="brand-block">
                <Label text="WellBalance" styleClass="brand-title"/>
                <Label text="Dashboard administration" styleClass="brand-subtitle"/>
            </VBox>
            <Label text="DASHBOARD" styleClass="sidebar-section"/>
            <Button text="Tableau de bord" onAction="#openDashboard" styleClass="sidebar-button-outline"/>
            <Label text="GESTION" styleClass="sidebar-section"/>
            <Button text="Ajouter rendez-vous" onAction="#openAjouterRdv" styleClass="sidebar-button-outline"/>
            <Button text="Liste rendez-vous" onAction="#openAfficherRdv" styleClass="sidebar-button-outline"/>
            <Button text="Validation admin" onAction="#openModifierRdv" styleClass="sidebar-button-outline"/>
            <Button text="Suppression rendez-vous" onAction="#openSupprimerRdv" styleClass="sidebar-button-outline"/>
            <Button text="Ajouter type" onAction="#openAjouterType" styleClass="sidebar-button-outline"/>
            <Button text="Liste des types" onAction="#openAfficherType" styleClass="sidebar-button-outline"/>
            <Button text="Modifier type" onAction="#openModifierType" styleClass="sidebar-button"/>
            <Button text="Supprimer type" onAction="#openSupprimerType" styleClass="sidebar-button-outline"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="sidebar-note">
                <Label text="Edition propre" styleClass="sidebar-note-title"/>
                <Label text="Formulaire compacte pour garder les boutons visibles." wrapText="true" styleClass="sidebar-note-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="page-container form-page">
            <HBox styleClass="topbar" spacing="16">
                <VBox spacing="4">
                    <Label text="Modifier un type de rendez-vous" styleClass="page-title"/>
                    <Label text="Liste filtrable a gauche, formulaire d'edition a droite." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualiser" onAction="#loadData" styleClass="secondary-button"/>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox styleClass="card compact-table-card" spacing="10" HBox.hgrow="ALWAYS">
                    <HBox styleClass="filters-row">
                        <TextField fx:id="searchField" promptText="Rechercher sur plusieurs attributs..." HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="categorieFilter" promptText="Categorie" prefWidth="170"/>
                        <ComboBox fx:id="sortCombo" promptText="Tri" prefWidth="180"/>
                        <Button text="Reinitialiser" onAction="#resetFilters" styleClass="ghost-button"/>
                    </HBox>

                    <TableView fx:id="typeTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                            <TableColumn fx:id="colLibelle" text="Libelle" prefWidth="180"/>
                            <TableColumn fx:id="colDescription" text="Description" prefWidth="280"/>
                            <TableColumn fx:id="colDuree" text="Duree" prefWidth="100"/>
                            <TableColumn fx:id="colPrix" text="Prix" prefWidth="100"/>
                            <TableColumn fx:id="colCategorie" text="Categorie" prefWidth="170"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox styleClass="card form-card" prefWidth="410" HBox.hgrow="NEVER">
                    <Label text="Edition du type selectionne" styleClass="card-title"/>
                    <Separator/>

                    <Label text="Informations principales" styleClass="form-section-title"/>
                    <VBox spacing="6" styleClass="form-group">
                        <Label text="Libelle" styleClass="section-label"/>
                        <TextField fx:id="libelleField" promptText="Nom du type" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6" styleClass="form-group">
                        <Label text="Description" styleClass="section-label"/>
                        <TextArea fx:id="descriptionArea" promptText="Description" prefHeight="88" maxWidth="Infinity"/>
                    </VBox>

                    <Label text="Parametres" styleClass="form-section-title"/>
                    <HBox spacing="12" styleClass="form-row">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Duree" styleClass="section-label"/>
                            <TextField fx:id="dureeField" promptText="Duree" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Prix" styleClass="section-label"/>
                            <TextField fx:id="prixField" promptText="Prix" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="6" styleClass="form-group">
                        <Label text="Categorie" styleClass="section-label"/>
                        <TextField fx:id="categorieField" promptText="Categorie" maxWidth="Infinity"/>
                    </VBox>

                    <Label text="Actions" styleClass="form-section-title"/>
                    <HBox spacing="10" styleClass="form-actions">
                        <Button text="Enregistrer" onAction="#modifierTypeRendezVous" styleClass="primary-button"/>
                        <Button text="Vider" onAction="#clearFields" styleClass="secondary-button"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
