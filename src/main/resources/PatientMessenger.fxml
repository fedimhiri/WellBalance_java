<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.PatientMessengerController"
            prefHeight="700.0" prefWidth="1200.0"
            styleClass="root">
            
    <stylesheets>
        <URL value="@/css/patient_messenger.css" />
    </stylesheets>

    <!-- Top Header -->
    <top>
        <HBox fx:id="headerBox" prefHeight="70.0"
              styleClass="header-box" alignment="CENTER_LEFT" spacing="15">
            <padding>
                <Insets left="20" right="20"/>
            </padding>
            <children>
                <Label text="💬" style="-fx-font-size: 28;"/>
                <Label text="Ma Messagerie" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10">
                    <StackPane>
                        <Circle radius="18" fill="white"/>
                        <Label fx:id="userAvatarLabel" text="A" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0d6efd;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="userNameLabel" text="Amine Kadri" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="En ligne" style="-fx-font-size: 11; -fx-text-fill: #a8d5ff;"/>
                    </VBox>
                </HBox>

                <Button text="Deconnexion" onAction="#handleLogout"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </children>
        </HBox>
    </top>

    <!-- Global Application Sidebar -->
    <left>
        <VBox prefWidth="250.0" styleClass="global-sidebar" spacing="20">
            <children>
                <Label text="MENU PRINCIPAL" style="-fx-font-size: 12; -fx-text-fill: #95a5a6; -fx-font-weight: bold;"/>
                <Button text="Gestion de messagerie" styleClass="btn-nav" prefWidth="220.0" alignment="CENTER_LEFT">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                </Button>
                <Region VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <HBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <VBox prefWidth="400.0" minWidth="300.0" spacing="15">
                    <!-- Conversations List -->
                    <Label text="Mes Conversations" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="searchField" promptText="Rechercher..." styleClass="search-field"/>

                    <ScrollPane fx:id="conversationsScroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox fx:id="conversationsList" spacing="5"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- Right Column Stacked -->
                <StackPane HBox.hgrow="ALWAYS" styleClass="chat-container">
                    <children>
                        <!-- Chat Area -->
                        <VBox fx:id="chatArea" visible="false">
                            <children>
                                <!-- Chat Header -->
                                <HBox prefHeight="70.0" styleClass="chat-header" alignment="CENTER_LEFT" spacing="12">
                                    <padding>
                                        <Insets left="20" right="20"/>
                                    </padding>
                                    <children>
                                        <StackPane>
                                            <Circle radius="20" fill="#e4e6eb"/>
                                            <Label fx:id="chatAvatarLabel" text="D" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #65676b;"/>
                                        </StackPane>
                                        <VBox alignment="CENTER_LEFT" spacing="3">
                                            <Label fx:id="chatUserNameLabel" text="Dr. Fedi" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                                            <Label fx:id="chatStatusLabel" text="Docteur" style="-fx-font-size: 12; -fx-text-fill: #65676b;"/>
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="⬅ Retour a l'accueil" onAction="#handleReturnHome"
                                                style="-fx-background-color: transparent; -fx-text-fill: #0d6efd; -fx-font-weight: bold; -fx-cursor: hand;"/>
                                        <Button text="🗑" onAction="#handleDeleteConversation"
                                                style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>

                                <!-- Messages Area -->
                                <ScrollPane fx:id="messagesScroll" VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER"
                                            style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;">
                                    <content>
                                        <VBox fx:id="messagesContainer" spacing="10" styleClass="messages-container"/>
                                    </content>
                                </ScrollPane>

                                <!-- Typing Indicator -->
                                <Label fx:id="typingLabel" text="Le docteur ecrit..." visible="false" managed="false"
                                       style="-fx-font-size: 12; -fx-text-fill: #65676b; -fx-font-style: italic; -fx-padding: 0 0 0 20;"/>

                                <!-- Reply Preview -->
                                <HBox fx:id="replyPreviewBox" visible="false" managed="false" alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color: #e7f3ff; -fx-padding: 8 15; -fx-border-color: #0084ff; -fx-border-width: 0 0 0 3;">
                                    <VBox HBox.hgrow="ALWAYS">
                                        <Label text="En reponse a:" style="-fx-font-size: 10; -fx-text-fill: #0084ff; -fx-font-weight: bold;"/>
                                        <Label fx:id="replyPreviewText" text="..." style="-fx-font-size: 12; -fx-text-fill: #333;" wrapText="true"/>
                                    </VBox>
                                    <Button text="✕" onAction="#handleCancelReply" style="-fx-background-color: transparent; -fx-text-fill: #666; -fx-cursor: hand; -fx-font-size: 14;"/>
                                </HBox>

                                <StackPane prefHeight="80.0" style="-fx-background-color: white; -fx-background-radius: 0 0 12 12; -fx-border-color: #e4e6eb; -fx-border-width: 1 0 0 0;">
                                    <padding>
                                        <Insets left="20" right="20"/>
                                    </padding>
                                    
                                    <!-- Standard Input -->
                                    <HBox fx:id="standardInputBox" alignment="CENTER" spacing="10">
                                        <HBox alignment="CENTER" spacing="5">
                                            <Button text="📎" onAction="#handleAttachment" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand; -fx-text-fill: #0d6efd;"/>
                                            <Button fx:id="recordBtn" text="🎤" onAction="#handleVoiceRecord" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand; -fx-text-fill: #e83f3f;"/>
                                        </HBox>
                                        
                                        <TextArea fx:id="messageInput" promptText="Ecrivez votre message..."
                                                  wrapText="true" styleClass="input-pill"
                                                  prefHeight="45.0" minHeight="45.0" maxHeight="45.0" HBox.hgrow="ALWAYS"/>
                                        
                                        <HBox alignment="CENTER" spacing="5">
                                            <Button text="😊" onAction="#handleEmojiPicker" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand;"/>
                                            <Button text="➤" onAction="#handleSendMessage"
                                                    styleClass="btn-primary" style="-fx-padding: 8 15; -fx-background-radius: 50; -fx-font-size: 16;"/>
                                        </HBox>
                                    </HBox>

                                    <!-- Voice Review Overlay -->
                                    <HBox fx:id="voiceReviewBox" visible="false" managed="false" alignment="CENTER" spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 30; -fx-padding: 5 15;">
                                        <Button fx:id="playPreviewBtn" text="▶" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-background-radius: 50; -fx-font-size: 14; -fx-cursor: hand;"/>
                                        <Label text="Vocal pre-rentré" style="-fx-text-fill: #666; -fx-font-style: italic;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="🗑 Annuler" onAction="#handleCancelVoice" style="-fx-background-color: transparent; -fx-text-fill: #dc3545; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                        <Button text="➤ Envoyer" onAction="#handleSendVoice" styleClass="btn-primary" style="-fx-background-radius: 30; -fx-padding: 8 20;"/>
                                    </HBox>
                                </StackPane>
                            </children>
                        </VBox>

                        <!-- Dashboard (Accueil) -->
                        <VBox fx:id="emptyState" spacing="0" style="-fx-background-color: white; -fx-background-radius: 12;" StackPane.alignment="CENTER">
                            <children>
                                <!-- Banner -->
                                <HBox alignment="CENTER_LEFT" styleClass="dashboard-banner">
                                    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <Label text="Bienvenue dans votre messagerie" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                        <Label text="Demarrez une nouvelle consultation en ligne rapidement" style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="40" VBox.vgrow="ALWAYS">
                                    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
                                    
                                    <!-- Left split: Form -->
                                    <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-padding: 30; -fx-border-color: #dee2e6; -fx-border-radius: 12;">
                                        <Label text="✨ Nouvelle Consultation" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                                        
                                        <HBox spacing="15">
                                            <ComboBox fx:id="doctorCombo" promptText="Choisir un Medecin..." styleClass="combo-box" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="45"/>
                                            <ComboBox fx:id="typeCombo" promptText="Type (ex: Urgence)" styleClass="combo-box" prefWidth="150" prefHeight="45"/>
                                        </HBox>
                                        
                                        <TextField fx:id="sujetField" promptText="Sujet de votre demande" styleClass="text-field" prefHeight="45"/>
                                        <TextArea fx:id="newMessageArea" promptText="Decrivez vos symptomes ou votre demande..." prefHeight="100" wrapText="true" styleClass="text-area"/>
                                        
                                        <HBox alignment="CENTER_RIGHT">
                                            <Button text="Envoyer la demande 🚀" onAction="#handleNewConversation" styleClass="btn-primary" style="-fx-padding: 12 30; -fx-font-size: 14;"/>
                                        </HBox>
                                    </VBox>

                                    <!-- Right split: Stats -->
                                    <VBox spacing="20" prefWidth="250" alignment="TOP_CENTER">
                                        <Label text="Mon Resume" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
                                        <VBox styleClass="card" alignment="CENTER" prefHeight="110" prefWidth="250">
                                            <Label fx:id="statTotalConv" text="0" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #0d6efd;"/>
                                            <Label text="Discussions activées" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
                                        </VBox>
                                        <VBox styleClass="card" alignment="CENTER" prefHeight="110" prefWidth="250">
                                            <Label fx:id="statUnread" text="0" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #198754;"/>
                                            <Label text="Messages non lus" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </center>
</BorderPane>
