<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ForgotPasswordController"
            prefWidth="1500" prefHeight="900"
            styleClass="login-root">

    <center>
        <HBox alignment="CENTER" prefHeight="900">

            <!-- Panneau gauche -->
            <VBox prefWidth="750" spacing="28" alignment="CENTER_LEFT"
                  styleClass="login-left-panel">
                <padding>
                    <Insets top="60" right="80" bottom="60" left="80"/>
                </padding>

                <Label text="Mot de passe oublié ?" styleClass="login-title"/>
                <Label text="Entrez votre email pour recevoir un code de vérification."
                       styleClass="login-subtitle" wrapText="true"/>

                <TextField fx:id="emailField"
                           promptText="Email"
                           prefHeight="52"
                           styleClass="input-field"/>

                <Label fx:id="messageLabel" wrapText="true"
                       styleClass="message-label"/>

                <Button text="Envoyer le code"
                        prefWidth="320" prefHeight="52"
                        styleClass="primary-button"
                        onAction="#handleSendCode"/>

                <Button text="← Retour à la connexion"
                        styleClass="bottom-link"
                        onAction="#goToLogin"/>
            </VBox>

            <!-- Panneau droit bleu -->
            <VBox prefWidth="750" spacing="20" alignment="CENTER"
                  styleClass="login-right-panel">
                <padding>
                    <Insets top="60" right="60" bottom="60" left="60"/>
                </padding>
                <Label text="Clinique Médicale" styleClass="right-title"/>
                <Label text="Réinitialisez votre mot de passe en toute sécurité."
                       styleClass="right-text" wrapText="true"/>
            </VBox>

        </HBox>
    </center>

</BorderPane>