<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.EditUserAdminController"
            prefWidth="1400.0" prefHeight="850.0"
            style="-fx-background-color: #f3f6fb;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #eef2f7; -fx-padding: 20 40 20 40;">
            <children>
                <Button text="← Retour"
                        onAction="#goBackToAdminDashboard"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 10 18 10 18;
                               -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="👤  Modification"
                       style="-fx-font-size: 30px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #123b6d;"/>

                <Region HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 40;">
            <children>

                <VBox spacing="18"
                      prefWidth="780"
                      maxWidth="780"
                      style="-fx-background-color: #f8f8f8;
                             -fx-background-radius: 18;
                             -fx-border-color: #e5e7eb;
                             -fx-border-radius: 18;
                             -fx-padding: 28;">

                    <children>

                        <VBox spacing="8">
                            <Label text="Adresse email"
                                   style="-fx-font-size: 15px; -fx-text-fill: #31598d;"/>
                            <TextField fx:id="emailField"
                                       prefHeight="54"
                                       style="-fx-background-radius: 12;
                                              -fx-border-radius: 12;
                                              -fx-border-color: #cbd5e1;
                                              -fx-font-size: 16px;"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Nom d'utilisateur"
                                   style="-fx-font-size: 15px; -fx-text-fill: #31598d;"/>
                            <TextField fx:id="usernameField"
                                       prefHeight="54"
                                       style="-fx-background-radius: 12;
                                              -fx-border-radius: 12;
                                              -fx-border-color: #cbd5e1;
                                              -fx-font-size: 16px;"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Téléphone"
                                   style="-fx-font-size: 15px; -fx-text-fill: #31598d;"/>
                            <TextField fx:id="telephoneField"
                                       prefHeight="54"
                                       style="-fx-background-radius: 12;
                                              -fx-border-radius: 12;
                                              -fx-border-color: #cbd5e1;
                                              -fx-font-size: 16px;"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Rôle"
                                   style="-fx-font-size: 15px; -fx-text-fill: #31598d;"/>
                            <ComboBox fx:id="roleComboBox"
                                      prefHeight="54"
                                      prefWidth="720"
                                      style="-fx-background-radius: 12;
                                             -fx-border-radius: 12;
                                             -fx-border-color: #cbd5e1;
                                             -fx-font-size: 15px;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="ROLE_ADMIN"/>
                                        <String fx:value="ROLE_USER"/>
                                        <String fx:value="ROLE_NUTRITIONNISTE"/>
                                        <String fx:value="ROLE_COACHSPORTIF"/>
                                        <String fx:value="ROLE_MEDECIN"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
                            <children>
                                <Button text="Annuler"
                                        onAction="#goBackToAdminDashboard"
                                        style="-fx-background-color: #e5e7eb;
                                               -fx-text-fill: #111827;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10;
                                               -fx-padding: 10 20 10 20;
                                               -fx-cursor: hand;"/>

                                <Button text="Enregistrer"
                                        onAction="#handleUpdateUser"
                                        style="-fx-background-color: #2563eb;
                                               -fx-text-fill: white;
                                               -fx-font-size: 14px;
                                               -fx-font-weight: bold;
                                               -fx-background-radius: 10;
                                               -fx-padding: 10 22 10 22;
                                               -fx-cursor: hand;"/>
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

</BorderPane>