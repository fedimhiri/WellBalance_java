<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.LoginController"
            prefWidth="1500.0" prefHeight="900.0"
            styleClass="login-root">

    <!-- ===== TOP BAR ===== -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT"
                  spacing="30"
                  prefHeight="42" minHeight="42" maxHeight="42"
                  styleClass="top-contact-bar">
                <padding>
                    <Insets top="0" right="70" bottom="0" left="70"/>
                </padding>
                <Label text="✉ wellbalance@gmail.com" styleClass="top-contact-label"/>
                <Label text="📱 +216 23223668"        styleClass="top-contact-label"/>
            </HBox>

            <HBox alignment="CENTER_LEFT"
                  prefHeight="82" minHeight="82"
                  styleClass="navbar">
                <padding>
                    <Insets top="0" right="70" bottom="0" left="70"/>
                </padding>

                <Label text="Clinique Médicale" styleClass="brand-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="18">
                    <Button text="Accueil"      styleClass="nav-link"/>
                    <Button text="Se connecter" styleClass="nav-outline-button"/>
                    <Label  text="OU"           styleClass="divider-text"/>
                    <Button text="Continuer avec Google"
                            styleClass="google-button"
                            prefWidth="240" prefHeight="42"
                            onAction="#handleGoogleLogin"/>
                    <Button text="S'inscrire"
                            styleClass="nav-primary-button"
                            onAction="#goToRegister"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CONTENU ===== -->
    <center>
        <HBox alignment="CENTER" styleClass="login-main-wrapper">

            <!-- ===== PANNEAU GAUCHE ===== -->
            <VBox alignment="CENTER_LEFT"
                  spacing="18"
                  prefWidth="750"
                  styleClass="login-left-panel">
                <padding>
                    <Insets top="50" right="55" bottom="50" left="55"/>
                </padding>

                <Label text="Connexion" styleClass="login-title"/>
                <Label text="Accédez à votre espace patient en toute sécurité."
                       styleClass="login-subtitle"/>

                <!-- Email -->
                <TextField fx:id="emailField"
                           promptText="Email"
                           styleClass="input-field"
                           prefWidth="650" prefHeight="46"/>

                <!-- Mot de passe -->
                <PasswordField fx:id="passwordField"
                               promptText="Mot de passe"
                               styleClass="input-field"
                               prefWidth="650" prefHeight="46"/>

                <!-- Se souvenir + Mot de passe oublié -->
                <HBox alignment="CENTER_LEFT" prefWidth="650">
                    <CheckBox text="Se souvenir de moi" styleClass="remember-check"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Mot de passe oublié ?"
                            styleClass="forgot-link"
                            onAction="#goToForgotPassword"/>
                </HBox>

                <!-- ===== CAPTCHA ===== -->
                <VBox spacing="8" prefWidth="650">
                    <Label text="Vérification de sécurité"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #163b7a;"/>

                    <StackPane prefWidth="650" minHeight="110" maxWidth="650"
                               style="-fx-background-color: #ffffff;
                                      -fx-border-color: #d9e2f2;
                                      -fx-border-width: 1;
                                      -fx-border-radius: 12;
                                      -fx-background-radius: 12;
                                      -fx-padding: 14;">
                        <HBox alignment="CENTER_LEFT" prefWidth="620">
                            <WebView fx:id="recaptchaWebView"
                                     prefWidth="320" prefHeight="78"
                                     minWidth="320"  minHeight="78"
                                     maxWidth="320"  maxHeight="78"/>
                        </HBox>
                    </StackPane>

                    <Label fx:id="captchaErrorLabel"
                           text="" visible="false" managed="false"
                           style="-fx-text-fill: #d93025; -fx-font-size: 12px;"/>
                </VBox>

                <!-- ===== BOUTONS LOGIN ===== -->
                <HBox spacing="15" alignment="CENTER_LEFT" prefWidth="650">

                    <!-- Login classique -->
                    <Button text="Se connecter"
                            styleClass="primary-button"
                            prefWidth="220" prefHeight="46"
                            onAction="#handleLogin"/>

                    <!-- ✅ Login reconnaissance faciale -->
                    <Button fx:id="btnFaceLogin"
                            text="🎥 Reconnaissance faciale"
                            styleClass="nav-outline-button"
                            prefWidth="230" prefHeight="46"
                            onAction="#handleFaceLogin"/>

                </HBox>

                <!-- Lien inscription -->
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Pas encore de compte ?" styleClass="bottom-text"/>
                    <Hyperlink text="Créer un compte"
                               styleClass="bottom-link"
                               onAction="#goToRegister"/>
                </HBox>

            </VBox>

            <!-- ===== PANNEAU DROIT BLEU ===== -->
            <StackPane prefWidth="750" styleClass="login-right-panel">
                <VBox alignment="CENTER" spacing="24" maxWidth="470">
                    <Label text="Bienvenue" styleClass="right-title"/>
                    <Label text="Gérez vos rendez-vous médicaux, consultez vos résultats et accédez à votre dossier médical en toute sécurité."
                           wrapText="true" maxWidth="430"
                           styleClass="right-text"/>
                    <Button text="⌂ Retour à l'accueil"
                            styleClass="secondary-white-button"/>
                </VBox>
            </StackPane>

        </HBox>
    </center>

</BorderPane>