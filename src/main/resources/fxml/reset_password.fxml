<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ResetPasswordController"
            prefWidth="1500" prefHeight="900"
            styleClass="login-root">

    <center>
        <HBox alignment="CENTER" prefHeight="900">

            <VBox prefWidth="750" spacing="28" alignment="CENTER_LEFT"
                  styleClass="login-left-panel">
                <padding>
                    <Insets top="60" right="80" bottom="60" left="80"/>
                </padding>

                <Label text="Nouveau mot de passe" styleClass="login-title"/>
                <Label text="Choisissez un nouveau mot de passe sécurisé."
                       styleClass="login-subtitle" wrapText="true"/>

                <PasswordField fx:id="passwordField"
                               promptText="Nouveau mot de passe"
                               prefHeight="52"
                               styleClass="input-field"/>

                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirmer le mot de passe"
                               prefHeight="52"
                               styleClass="input-field"/>

                <Label fx:id="messageLabel" wrapText="true"
                       styleClass="message-label"/>

                <Button text="Réinitialiser le mot de passe"
                        prefWidth="320" prefHeight="52"
                        styleClass="primary-button"
                        onAction="#handleReset"/>
            </VBox>

            <VBox prefWidth="750" spacing="20" alignment="CENTER"
                  styleClass="login-right-panel">
                <padding>
                    <Insets top="60" right="60" bottom="60" left="60"/>
                </padding>
                <Label text="Clinique Médicale" styleClass="right-title"/>
                <Label text="Votre nouveau mot de passe sera haché et stocké en sécurité."
                       styleClass="right-text" wrapText="true"/>
            </VBox>

        </HBox>
    </center>

</BorderPane>