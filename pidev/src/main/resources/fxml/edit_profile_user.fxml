<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.EditProfileUserController"
            prefWidth="1000" prefHeight="700"
            styleClass="edit-user-root">

    <!-- ===== NAVBAR USER (au lieu sidebar) ===== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="navbar" prefHeight="80">
            <padding>
                <Insets top="0" right="40" bottom="0" left="40"/>
            </padding>

            <children>
                <Label text="Mon Profil" styleClass="brand-title"/>
                <Region HBox.hgrow="ALWAYS"/>

                <Button text="Retour"
                        styleClass="nav-primary-button"
                        onAction="#goToFrontOffice"/>

                <Button text="Se déconnecter"
                        styleClass="logout-button"
                        onAction="#logout"/>
            </children>
        </HBox>
    </top>

    <!-- ===== CONTENU PRINCIPAL (identique admin) ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <content>
                <VBox spacing="25" maxWidth="700" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="40" right="60" bottom="40" left="60"/>
                    </padding>

                    <!-- Titre -->
                    <HBox alignment="CENTER" spacing="10">
                        <Label text="👤" styleClass="profile-icon"/>
                        <Label text="Mon Profil" styleClass="edit-title"/>
                    </HBox>

                    <!-- Card infos -->
                    <VBox styleClass="content-card" spacing="18">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>

                        <Label text="Adresse email" styleClass="field-label"/>
                        <TextField fx:id="emailField" styleClass="profile-field"
                                   promptText="Adresse email"/>

                        <Label text="Nom d'utilisateur" styleClass="field-label"/>
                        <TextField fx:id="usernameField" styleClass="profile-field"
                                   promptText="Nom d'utilisateur"/>

                        <Label text="Téléphone" styleClass="field-label"/>
                        <TextField fx:id="telephoneField" styleClass="profile-field"
                                   promptText="Téléphone"/>
                    </VBox>

                    <Separator/>

                    <!-- Card mot de passe -->
                    <VBox styleClass="content-card" spacing="18">
                        <padding>
                            <Insets top="25" right="25" bottom="25" left="25"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔒" styleClass="profile-icon"/>
                            <Label text="Modifier le mot de passe" styleClass="section-title-blue"/>
                        </HBox>

                        <Label text="Nouveau mot de passe" styleClass="field-label"/>
                        <PasswordField fx:id="passwordField" styleClass="profile-field"
                                       promptText="Nouveau mot de passe"/>

                        <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                        <PasswordField fx:id="confirmPasswordField" styleClass="profile-field"
                                       promptText="Confirmer le mot de passe"/>
                    </VBox>

                    <!-- Message -->
                    <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"/>

                    <!-- Boutons -->
                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="Annuler" styleClass="reset-button"
                                onAction="#goToFrontOffice"/>

                        <Button text="Enregistrer les modifications" styleClass="btn-save"
                                onAction="#handleSave"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>