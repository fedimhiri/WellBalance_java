<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AdminDashboardController"
            prefWidth="1400.0" prefHeight="850.0"
            styleClass="admin-root">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox prefWidth="260" spacing="20" styleClass="sidebar">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>

            <Label text="symfony admin" styleClass="sidebar-logo"/>

            <!-- Navigation principale -->
            <VBox spacing="10">
                <Button text="Dashboard"    styleClass="sidebar-button-active" maxWidth="Infinity"/>
                <Button text="Front Office" styleClass="sidebar-button" maxWidth="Infinity"
                        onAction="#goToFrontOffice"/>
                <Button text="Mon profil"   styleClass="sidebar-button" maxWidth="Infinity"
                        onAction="#goToMyProfile"/>
                <Button text="Sessions"
                        styleClass="sidebar-button"
                        maxWidth="Infinity"
                        onAction="#goToSessions"/>
            </VBox>

            <Label text="GESTION" styleClass="sidebar-section-title"/>

            <!-- Navigation gestion -->
            <VBox spacing="10">
                <Button text="Utilisateurs" styleClass="sidebar-button" maxWidth="Infinity"/>
                <Button text="Projets"      styleClass="sidebar-button" maxWidth="Infinity"/>
                <Button text="Commandes"    styleClass="sidebar-button" maxWidth="Infinity"/>
                <Button text="Statistiques" styleClass="sidebar-button" maxWidth="Infinity"/>
                <Button text="Messagerie" styleClass="sidebar-button" maxWidth="Infinity"
                        onAction="#goToMessagerie"/>
            </VBox>

            <!-- Bouton logout poussé en bas -->
            <Region VBox.vgrow="ALWAYS"/>
            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Se déconnecter"
                    styleClass="logout-button"
                    maxWidth="Infinity"
                    onAction="#logout"/>

        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <VBox spacing="20" styleClass="admin-content">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Barre de recherche et filtres -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField promptText="Rechercher par email, username ou téléphone"
                           styleClass="search-field"
                           prefWidth="520"/>

                <ComboBox prefWidth="200" styleClass="filter-combo">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Tous"/>
                            <String fx:value="ROLE_ADMIN"/>
                            <String fx:value="ROLE_USER"/>
                            <String fx:value="ROLE_PATIENT"/>
                            <String fx:value="ROLE_MEDECIN"/>
                            <String fx:value="ROLE_COACHSPORTIF"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Button text="Réinitialiser" styleClass="reset-button"/>
            </HBox>

            <!-- Tableau -->
            <VBox styleClass="content-card" spacing="15" VBox.vgrow="ALWAYS">
                <Label text="Bienvenue dans l'espace Admin" styleClass="dashboard-title"/>

                <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"        text="#"         prefWidth="60"/>
                        <TableColumn fx:id="colEmail"     text="EMAIL"     prefWidth="250"/>
                        <TableColumn fx:id="colUsername"  text="USERNAME"  prefWidth="200"/>
                        <TableColumn fx:id="colTelephone" text="TÉLÉPHONE" prefWidth="140"/>
                        <TableColumn fx:id="colRoles"     text="RÔLE(S)"   prefWidth="220"/>
                        <TableColumn fx:id="colStatut"    text="STATUT"    prefWidth="100"/>
                        <TableColumn fx:id="colActions"   text="ACTIONS"   prefWidth="250"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>